# Zkopírujte do .env a doplňte. Soubor .env je v .gitignore – nikdy ho necommitujte.
# Lokální vývoj používá jen testovací (sandbox) klíče. Ostré klíče (_live_) sem NEPATŘÍ.

# Stripe (sandbox): restricted key rk_test_… nebo sk_test_…
STRIPE_API_KEY=
# whsec_… z výstupu `stripe listen --forward-to localhost:8080/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false

# Adresa backendu (QR kódy, odkazy v e-mailech) a webu
S74_PUBLIC_BASE_URL=http://localhost:8080
S74_FRONTEND_BASE_URL=http://localhost:8000
S74_CORS_ALLOWED_ORIGINS=http://localhost:8000

# Databáze (lokálně netřeba nastavovat – výchozí hodnoty odpovídají docker-compose.yml).
# Prázdné hodnoty by přepsaly výchozí, proto jsou volitelné řádky zakomentované.
# DATABASE_URL=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# SMTP (lokálně Mailpit na 1025)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# S74_MAIL_FROM=

# První účet vedoucího (jen pokud ještě žádný neexistuje); po prvním startu odstranit
# S74_BOOTSTRAP_ADMIN_USERNAME=
# S74_BOOTSTRAP_ADMIN_PASSWORD=
