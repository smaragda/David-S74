# Zkopírujte do .env a doplňte. Soubor .env je v .gitignore – nikdy ho necommitujte.
# Lokální vývoj používá jen testovací (sandbox) klíče. Ostré klíče (_live_) sem NEPATŘÍ.

# Stripe (sandbox): restricted key rk_test_… nebo sk_test_…
STRIPE_API_KEY=
# whsec_… z výstupu `stripe listen --forward-to 127.0.0.1:8080/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false

# Adresa backendu (QR kódy, odkazy v e-mailech) a webu
S74_PUBLIC_BASE_URL=http://127.0.0.1:8080
S74_FRONTEND_BASE_URL=http://localhost:8000
S74_CORS_ALLOWED_ORIGINS=http://localhost:8000

# Databáze (lokálně netřeba nastavovat – výchozí hodnoty odpovídají docker-compose.yml).
# Prázdné hodnoty by přepsaly výchozí, proto jsou volitelné řádky zakomentované.
# DATABASE_URL=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# SMTP (lokálně Mailpit na 1025)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# S74_MAIL_FROM=

# První účet vedoucího (jen pokud ještě žádný neexistuje); po prvním startu odstranit
# S74_BOOTSTRAP_ADMIN_USERNAME=
# S74_BOOTSTRAP_ADMIN_PASSWORD=

# Správce platformy (zakládá podniky, Stripe Connect); jen pokud ještě žádný neexistuje, po prvním startu odstranit
# S74_BOOTSTRAP_PLATFORM_ADMIN_USERNAME=
# S74_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=

# Stripe Connect (více podniků). Vyžaduje zapnutý Connect na platformním Stripe účtu (Dashboard → Connect).
# S74_CONNECT_ENABLED=true
# whsec_… z `stripe listen --forward-connect-to 127.0.0.1:8080/api/stripe/connect-webhook`
# STRIPE_CONNECT_WEBHOOK_SECRET=
# whsec_… v2 event destination (thin events účtů) → /api/stripe/account-events
# STRIPE_ACCOUNT_EVENTS_WEBHOOK_SECRET=
