# Vzor souboru /opt/s74-vouchers/.env na serveru (práva 600, vlastník deploy uživatel). Skutečné hodnoty NIKDY do gitu.
# Hodnoty s mezerami nebo & nezabalujte do uvozovek (docker compose je čte doslovně).

# --- databáze (kontejner postgres) ---
DB_NAME=s74_vouchers
DB_USER=s74_vouchers
DB_PASSWORD=

# --- Stripe (restricted key rk_test_… / rk_live_… a whsec_… z Dashboardu) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# false = sandbox klíče, true = ostré klíče (aplikace odmítne start, pokud klíč a režim nesedí)
STRIPE_LIVEMODE=false

# --- adresy ---
S74_PUBLIC_BASE_URL=https://vouchery.s74.cz
S74_FRONTEND_BASE_URL=https://s74.cz
S74_CORS_ALLOWED_ORIGINS=https://s74.cz,https://www.s74.cz

# --- SMTP (poskytovatel e-mailů) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
S74_MAIL_FROM=S74 wine&café <vouchery@s74.cz>

# --- první vedoucí (po prvním startu tyto dva řádky smažte a `docker compose up -d` znovu) ---
S74_BOOTSTRAP_ADMIN_USERNAME=
S74_BOOTSTRAP_ADMIN_PASSWORD=
